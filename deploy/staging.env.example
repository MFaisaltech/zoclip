# Metadata only. Secrets are files under a private directory, never environment values.
APP_IMAGE=SET_REVIEWED_APP_IMAGE_AT_SHA256
NGINX_IMAGE=SET_REVIEWED_NGINX_DIGEST
OPS_IMAGE=SET_REVIEWED_OPS_IMAGE_AT_SHA256
PRIVATE_DIR=/etc/zoclip/private
BACKUP_DIR=/var/backups/zoclip
PUBLIC_APP_URL=https://SET_FRONTEND_DOMAIN
API_PUBLIC_URL=https://SET_API_DOMAIN
ALLOWED_HOSTS=["SET_API_DOMAIN"]
STAGING_HTTPS_PORT=8443
STAGING_ADMIN_PORT=8444
