# Nonsecret metadata only. This file is NOT ready for execution until all SET_* values are reviewed.
APP_IMAGE=SET_REVIEWED_APP_IMAGE_AT_SHA256
NGINX_IMAGE=SET_REVIEWED_NGINX_IMAGE_AT_SHA256
OPS_IMAGE=SET_REVIEWED_OPS_IMAGE_AT_SHA256
PRIVATE_DIR=/etc/zoclip/private
BACKUP_DIR=/var/backups/zoclip
# Both browser origins must belong to this OWNED site. Never use vercel.app as the site.
STAGING_SITE_DOMAIN=SET_OWNED_DOMAIN
# Nonsecret UUID scoped to this deployment. Rotate after restores, never restore an old epoch.
STAGING_INVITE_EPOCH=SET_NEW_DEPLOYMENT_UUID
PUBLIC_APP_URL=https://SET_FRONTEND_HOST
API_PUBLIC_URL=https://SET_API_HOST:8443
ALLOWED_HOSTS=["SET_API_HOST"]
STAGING_HTTPS_PORT=8443
STAGING_ADMIN_PORT=8444
EDGE_SUBNET=172.30.70.0/24
PROXY_ADDRESS=172.30.70.10
