FROM postgres:17-bookworm@sha256:3645570cccdfa447589da9f57dd740faa29b30938e861289a5574b6ca6b03826
RUN apt-get update && apt-get install -y --no-install-recommends age=1.1.1-1+b3 python3=3.11.2-1+b1 openssh-client=1:9.2p1-2+deb12u10 \
    && rm -rf /var/lib/apt/lists/*
COPY deploy/backup.py /opt/zoclip/backup.py
USER 10001:10001
ENTRYPOINT ["python3", "/opt/zoclip/backup.py"]
