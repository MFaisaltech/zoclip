APP_ENV=development
DATABASE_URL=postgresql+psycopg://zoclip:CHANGE_ME@db:5432/zoclip
POSTGRES_PASSWORD=CHANGE_ME
# Payments stay disabled. Mock mode requires a privately generated 32+ character key.
PAYMENT_MOCK_WEBHOOK_SECRET=
REDIS_URL=redis://redis:6379/0
PUBLIC_APP_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8000
ALLOWED_HOSTS=["localhost","127.0.0.1"]
# Only for local HTTP. Production MUST use true and HTTPS origins.
COOKIE_SECURE=false
SESSION_TTL_SECONDS=86400
ANONYMOUS_TTL_SECONDS=1800
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=900
# disabled, development (private local mailbox), or smtp (authenticated TLS only).
EMAIL_MODE=development
DEV_MAILBOX_DIR=/app/var/mailbox
# Required before enabling production registration. Keep staging EMAIL_MODE=disabled.
SMTP_HOST=
SMTP_PORT=465
SMTP_TLS=implicit
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TIMEOUT_SECONDS=15
# Private base64-encoded random 32-byte key, required in SMTP mode. Never commit it.
EMAIL_QUEUE_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MEDIA_ROOT=var/media
MEDIA_MAX_BYTES=4294967296
MEDIA_PART_BYTES=8388608
MEDIA_HEADROOM_BYTES=21474836480
MEDIA_RETAINED_BYTES=42949672960
MEDIA_ALLOWED_IMPORT_HOSTS=[]
# YouTube uses the image-installed yt-dlp, EJS, Node and bgutil plugin.
# Production private connectivity is opt-in via deploy/compose.youtube-import.yaml.
# Never put proxy credentials into logs or expose WARP/PO-token TCP ports.
LINK_PROXY_URL=
LINK_EXTRACTOR_ARGS=youtube:player_client=mweb;fetch_pot=always
LINK_DEADLINE_SECONDS=3600
MEDIA_INGESTION_LIMIT=2
MEDIA_USER_INGESTION_LIMIT=1
MEDIA_PENDING_LIMIT=10
MEDIA_USER_PROCESSING_LIMIT=1
MEDIA_UPLOAD_TTL_SECONDS=86400
MEDIA_RETENTION_SECONDS=604800
FFPROBE_BINARY=ffprobe
FFMPEG_BINARY=ffmpeg
RENDER_DEADLINE_SECONDS=240
RENDER_MAX_BYTES=268435456

# Phase 4 disabled until explicitly enabled with reviewed models, rates and budgets.
# Keys remain private. Never use real keys in test overrides or smoke runs.
AI_ENABLED=false
TRANSCRIPTION_PROVIDER=whisper
ANALYSIS_PROVIDER=local
WHISPER_MODEL=small
WHISPER_COMPUTE_TYPE=int8
WHISPER_DEVICE=cpu
WHISPER_MODEL_PATH=/opt/models/faster-whisper-small
# Bounded local inference per queue claim; one second of context at either seam.
WHISPER_CHUNK_SECONDS=120
WHISPER_OVERLAP_SECONDS=1
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=
DEEPGRAM_VERSION=
DEEPGRAM_LANGUAGE=en
AI_APPROVED_LANGUAGES=["en"]
DEEPGRAM_DIARIZE=false
DEEPGRAM_UTTERANCES=false
DEEPGRAM_MIP_OPT_OUT=true
GEMINI_API_KEY=
GEMINI_MODEL=
AI_PROVIDER_TIMEOUT_SECONDS=120
AI_CALLS_PER_MINUTE=6
AI_CHUNK_BYTES=16000
AI_MAX_CHUNKS=32
AI_MAX_OUTPUT_TOKENS=2048
AI_MAX_CANDIDATES=10
AI_MIN_CLIP_SECONDS=15
AI_MAX_CLIP_SECONDS=90
GOOGLE_REDIRECT_URI=
PAYMENT_PROVIDER=disabled
ENABLE_LIVE_PAYMENTS=false
ENABLE_TRIAL_CREDITS=false
# Phase 2: prices, allowances, consumption rules, rate versions and USD budgets
# are audited PostgreSQL configuration via /api/v1/admin routes (see
# docs/CREDITS_AND_MARGIN.md). No commercial prices/rates/budgets are seeded.
# Automatic trial enablement is rejected pending the missing anti-abuse controls.
DEPLOYMENT_TIER=production
STAGING_GENERATION_ENABLED=false
STAGING_GENERATION_USER_ID=
