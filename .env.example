APP_ENV=development
DATABASE_URL=postgresql+psycopg://zoclip:CHANGE_ME@db:5432/zoclip
POSTGRES_PASSWORD=CHANGE_ME
REDIS_URL=redis://redis:6379/0
PUBLIC_APP_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8000
ALLOWED_HOSTS=["localhost","127.0.0.1"]
# Only for local HTTP. Production MUST use true and HTTPS origins.
COOKIE_SECURE=false
SESSION_TTL_SECONDS=86400
ANONYMOUS_TTL_SECONDS=1800
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=900
# disabled or development; development writes private local files, never sends email.
EMAIL_MODE=development
DEV_MAILBOX_DIR=/app/var/mailbox
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
PAYMENT_PROVIDER=disabled
ENABLE_LIVE_PAYMENTS=false
ENABLE_TRIAL_CREDITS=false
